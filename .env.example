# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Required only when running with --provider anthropic
ANTHROPIC_API_KEY=

# Required for --provider anthropic. Set to any current Anthropic model id.
# See https://docs.anthropic.com/en/docs/about-claude/models
EVAL_JUDGE_MODEL=

# Optional defaults (CLI flags override these)
EVAL_PROVIDER=mock
EVAL_RUNS=5
EVAL_JUDGE_TEMPERATURE=0.0
